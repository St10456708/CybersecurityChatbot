<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ CyberBot v3.0 — Cybersecurity Awareness Bot"
        Height="850" Width="1200"
        MinHeight="700" MinWidth="900"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00D4FF"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#58E6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#009DBB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#484F58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DA3633"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F85149"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3FB950"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#00D4FF"/>
                                <Setter Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#3D444D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CaretBrush" Value="#00D4FF"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButtonActive" TargetType="Button">
            <Setter Property="Background" Value="#00D4FF"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonInactive" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" Background="#00D4FF" CornerRadius="21" Margin="0,0,12,0">
                    <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CyberBot v3.0" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                    <TextBlock x:Name="StatusText" Text="● Online — Cybersecurity Awareness Bot" FontSize="11" Foreground="#3FB950"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MOOD DETECTOR" FontSize="9" FontWeight="Bold" Foreground="#484F58" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SentimentLabel" Text="😐  Neutral" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 1: ASCII SPLASH -->
        <Border x:Name="AsciiSplash" Grid.Row="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="0,10,0,10">
            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#00D4FF" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="  ██████╗██╗   ██╗██████╗ ███████╗██████╗     ██████╗  ██████╗ ████████╗&#xa;  ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗    ██╔══██╗██╔═══██╗╚══██╔══╝&#xa;  ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝    ██████╔╝██║   ██║   ██║   &#xa;  ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗    ██╔══██╗██║   ██║   ██║   &#xa;  ╚██████╗   ██║   ██████╔╝███████╗██║  ██║    ██████╔╝╚██████╔╝   ██║   &#xa;   ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝    ╚═════╝  ╚═════╝    ╚═╝   &#xa;&#xa;            🛡️  CYBERSECURITY AWARENESS BOT  v3.0  🛡️&#xa;            ──────────────────────────────────────────&#xa;              Your Intelligent Digital Guardian Online"/>
        </Border>

        <!-- ROW 2: NAME ENTRY BAR -->
        <Border x:Name="NameBar" Grid.Row="2" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="👤  Your Name:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <TextBox x:Name="NameInput" Width="240" Style="{StaticResource InputStyle}" KeyDown="NameInput_KeyDown"/>
                <Button Content="Start Chat  ➤" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="StartChat_Click"/>
            </StackPanel>
        </Border>

        <!-- ROW 3: MAIN CONTENT AREA (Tabs) -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TAB BUTTONS -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#0D1117" Margin="16,8,0,0">
                <Button x:Name="TabChatBtn" Content="💬 Chat" Style="{StaticResource TabButtonActive}" Click="TabChat_Click"/>
                <Button x:Name="TabTaskBtn" Content="✅ Task Assistant" Style="{StaticResource TabButtonInactive}" Click="TabTask_Click" Margin="4,0,0,0"/>
                <Button x:Name="TabQuizBtn" Content="🎮 Quiz" Style="{StaticResource TabButtonInactive}" Click="TabQuiz_Click" Margin="4,0,0,0"/>
                <Button x:Name="TabLogBtn" Content="📋 Activity Log" Style="{StaticResource TabButtonInactive}" Click="TabLog_Click" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!-- TAB: CHAT                               -->
            <!-- ═══════════════════════════════════════ -->
            <Border x:Name="ChatTab" Grid.Row="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Margin="0,0,0,0">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16,10">
                    <StackPanel x:Name="ChatPanel"/>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- TAB: TASK ASSISTANT                     -->
            <!-- ═══════════════════════════════════════ -->
            <Border x:Name="TaskTab" Grid.Row="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Visibility="Collapsed">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Add Task Form -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="➕ Add New Cybersecurity Task" FontSize="16" FontWeight="Bold" Foreground="#00D4FF" Margin="0,0,0,16"/>

                        <TextBlock Text="Task Title:" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <TextBox x:Name="TaskTitleInput" Style="{StaticResource InputStyle}" Margin="0,0,0,12"
                                 ToolTip="e.g. Enable two-factor authentication"/>

                        <TextBlock Text="Description:" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <TextBox x:Name="TaskDescInput" Style="{StaticResource InputStyle}" Height="80"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12" ToolTip="Describe what needs to be done"/>

                        <TextBlock Text="Reminder (e.g. 7 days / 2026-07-01):" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <TextBox x:Name="TaskReminderInput" Style="{StaticResource InputStyle}" Margin="0,0,0,20"
                                 ToolTip="Optional: enter a number of days or a specific date"/>

                        <Button Content="💾  Save Task to Database" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Click="AddTask_Click"/>

                        <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,20,0,0">
                            <TextBlock x:Name="TaskStatusLabel" Text="Ready to add tasks." Foreground="#8B949E"
                                       TextWrapping="Wrap" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: View & Manage Tasks -->
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋 My Cybersecurity Tasks" FontSize="16" FontWeight="Bold" Foreground="#00D4FF"/>
                            <Button Grid.Column="1" Content="🔄 Refresh" Style="{StaticResource ChipButton}"
                                    Click="RefreshTasks_Click"/>
                        </Grid>
                        <ScrollViewer Height="500" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel x:Name="TaskListPanel"/>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- TAB: QUIZ                               -->
            <!-- ═══════════════════════════════════════ -->
            <Border x:Name="QuizTab" Grid.Row="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Quiz Header -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="🎮 Cybersecurity Quiz" FontSize="22" FontWeight="Bold" Foreground="#00D4FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Test your cybersecurity knowledge!" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Score + Progress -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#00D4FF" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SCORE" FontSize="10" FontWeight="Bold" Foreground="#484F58" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QuizScoreLabel" Text="0" FontSize="28" FontWeight="Bold" Foreground="#00D4FF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="QUESTION" FontSize="10" FontWeight="Bold" Foreground="#484F58" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QuizProgressLabel" Text="0 / 12" FontSize="28" FontWeight="Bold" Foreground="#E6EDF3" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="16,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#484F58" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QuizStatusBadge" Text="Ready" FontSize="20" FontWeight="Bold" Foreground="#3FB950" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Question Display -->
                        <Border Grid.Row="2" Background="#161B22" BorderBrush="#00D4FF" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <TextBlock x:Name="QuizQuestionLabel"
                                       Text="Click 'Start Quiz' to begin!"
                                       Foreground="#E6EDF3" FontSize="16" TextWrapping="Wrap" LineHeight="26"/>
                        </Border>

                        <!-- Answer Options -->
                        <StackPanel Grid.Row="3" x:Name="QuizOptionsPanel" Margin="0,0,0,16"/>

                        <!-- Feedback -->
                        <Border Grid.Row="4" x:Name="QuizFeedbackBorder" Background="#161B22" BorderBrush="#3FB950"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="QuizFeedbackLabel" Foreground="#E6EDF3" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Quiz Buttons -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="StartQuizBtn" Content="🚀  Start Quiz" Style="{StaticResource PrimaryButton}"
                                    Click="StartQuiz_Click" Margin="0,0,12,0"/>
                            <Button x:Name="NextQuestionBtn" Content="Next Question  ➤" Style="{StaticResource SuccessButton}"
                                    Click="NextQuestion_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- TAB: ACTIVITY LOG                       -->
            <!-- ═══════════════════════════════════════ -->
            <Border x:Name="LogTab" Grid.Row="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Visibility="Collapsed">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📋 Activity Log" FontSize="18" FontWeight="Bold" Foreground="#00D4FF"/>
                            <TextBlock x:Name="LogCountLabel" Text="0 actions recorded" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🗑️ Clear Log" Style="{StaticResource DangerButton}" Click="ClearLog_Click" VerticalAlignment="Top"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogPanel"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="ShowMoreLogBtn" Content="Show More ▼" Style="{StaticResource ChipButton}" Click="ShowMoreLog_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 4: QUICK TOPIC CHIPS -->
        <Border Grid.Row="4" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="12,8">
            <WrapPanel x:Name="ChipsPanel" HorizontalAlignment="Center">
                <Button Content="🔑 Password" Tag="password" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="🎣 Phishing" Tag="phishing" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="🦠 Malware" Tag="malware" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="🔐 2FA" Tag="2fa" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="🕵️ Privacy" Tag="privacy" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="📶 VPN" Tag="vpn" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="🔥 Ransomware" Tag="ransomware" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="⚠️ Scam" Tag="scam" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="✅ Add Task" Tag="add task" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="🎮 Start Quiz" Tag="start quiz" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
                <Button Content="📋 Show Log" Tag="show log" Style="{StaticResource ChipButton}" Click="Chip_Click" IsEnabled="False"/>
            </WrapPanel>
        </Border>

        <!-- ROW 5: TEXT INPUT BAR -->
        <Border Grid.Row="5" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UserInput" Grid.Column="0" Style="{StaticResource InputStyle}"
                         IsEnabled="False" KeyDown="UserInput_KeyDown" TextChanged="UserInput_TextChanged"
                         ToolTip="Type your message and press Enter or click Send"/>
                <Button x:Name="SendBtn" Grid.Column="1" Content="Send ➤" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="SendBtn_Click" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
